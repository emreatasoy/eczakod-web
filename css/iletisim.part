
/* ---------- İletişim ---------- */
.iletisim { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); gap: 56px; padding-top: 56px; padding-bottom: 96px; align-items: start; }
.form { display: grid; grid-template-columns: 1fr 1fr; gap: 18px 20px; }
.form .tam { grid-column: 1 / -1; }
.form label { display: grid; gap: 6px; font-weight: 600; font-size: 15px; color: var(--murekkep); }
.form label small { font-weight: 400; color: var(--soluk); }
.form input, .form select, .form textarea { font: 400 16px/1.4 var(--govde); color: var(--murekkep); background: #fff; border: 1.5px solid #C9CED6; border-radius: 10px;
  padding: 12px 14px; width: 100%; }
.form textarea { min-height: 150px; resize: vertical; }
.form input:hover, .form select:hover, .form textarea:hover { border-color: #9AA2AE; }
.form input:focus, .form select:focus, .form textarea:focus { border-color: #2563EB; outline: none; box-shadow: 0 0 0 3px rgba(37,99,235,.18); }
.form input:user-invalid, .form textarea:user-invalid { border-color: var(--gecmis); }
.form .onay { display: flex; gap: 12px; align-items: flex-start; font-weight: 400; font-size: 15px; color: var(--metin); }
.form .onay input { width: 20px; height: 20px; margin: 2px 0 0; flex: none; accent-color: var(--kirmizi); }
.form .bal { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
.form .gonder-satir { display: flex; flex-wrap: wrap; gap: 16px; align-items: center; }
.form button[disabled] { opacity: .6; cursor: progress; }
.form-durum { grid-column: 1 / -1; border-radius: 10px; padding: 14px 16px; font-size: 15.5px; }
.form-durum.tamam { background: #E8F7EE; color: #14532D; }
.form-durum.hata { background: #FDEDEF; color: #7F1D1D; }
.iletisim aside { display: grid; gap: 18px; }
.kart { background: var(--raf); border-radius: 16px; padding: 24px; }
.kart h2 { font-size: 22px; margin-bottom: 8px; }
.kart p { font-size: 16px; }
.kart .eposta { font: 600 19px/1.3 var(--govde); color: var(--kirmizi); text-decoration: none; }
.kart ul { margin: 8px 0 0; padding-left: 18px; font-size: 16px; }

@media (max-width: 900px) {
  .iletisim { grid-template-columns: 1fr; }
}
@media (max-width: 560px) {
  .form { grid-template-columns: 1fr; }
}

/* ---------- Gizlilik ---------- */
.metin-sayfa { max-width: 780px; padding-top: 56px; padding-bottom: 96px; }
.metin-sayfa h2 { font-size: 26px; margin: 40px 0 12px; }
.metin-sayfa h2:first-child { margin-top: 0; }
.metin-sayfa ul { padding-left: 20px; }
.metin-sayfa li { margin: 6px 0; }
.ozet-kartlar { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-bottom: 8px; }
.ozet-kartlar div { background: var(--raf); border-radius: 14px; padding: 18px; }
.ozet-kartlar b { display: block; font-size: 16px; margin-bottom: 4px; }
.ozet-kartlar span { font-size: 14.5px; color: var(--metin); line-height: 1.45; display: block; }
@media (max-width: 760px) { .ozet-kartlar { grid-template-columns: 1fr 1fr; } }
